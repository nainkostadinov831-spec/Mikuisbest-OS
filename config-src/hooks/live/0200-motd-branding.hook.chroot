#!/bin/sh
# Runs inside the chroot at build time. Writes a login banner that reminds
# the user what this system is for and what Tor does/doesn't protect,
# so the safety information travels with the ISO itself, not just docs.

set -eu

cat > /etc/motd <<'EOF'
=====================================================================
 Mikoisbest OS v1 — privacy & defensive network-security learning
=====================================================================
This system includes Tor, network-analysis, wireless-audit, and
password-auditing tools. Use network/wireless/password tools ONLY
against systems and networks you own or are explicitly authorized to
test.

Tor is installed but NOT started automatically. Start it with:
    sudo systemctl start tor
Tor protects the network path of torified traffic. It does not stop
DNS leaks, browser fingerprinting, or app-level identity leaks on its
own — see README section B on the build host, or the Tor Project's
own documentation, before relying on it for anything sensitive.
=====================================================================
EOF

echo "hook 0200: motd banner installed"
